{
  "name": "taskify-api-postgresql",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "db:migrate": "node --env-file=.env --experimental-strip-types src/migrate.ts",
    "dev": "node --env-file=.env --watch --experimental-strip-types src/server.ts",
    "start": "node --env-file=.env --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.9.0"
  }
}
