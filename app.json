{
  "expo": {
    "name": "Taskify",
    "slug": "gestion-de-projet-kanban",
    "scheme": "taskify",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F6F7"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9F6F7"
      },
      "package": "com.arymanga.gestiondeprojetkanban"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Taskify souhaite acc?der ? vos photos de profil.",
          "cameraPermission": "Taskify souhaite utiliser votre cam?ra pour votre photo de profil.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "mode": "local-demo"
    }
  }
}
