{
  "expo": {
    "name": "Taskify",
    "slug": "gestion-de-projet-kanban",
    "scheme": "taskify",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9F6F7"
      },
      "package": "com.shadrack_ntumba.gestiondeprojetkanban"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "mode": "local-demo",
      "eas": {
        "projectId": "d08a7319-9218-44d7-9102-38f39fc9660b"
      }
    }
  }
}
